#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Format the staged R files with air, then re-stage them so the formatted
# version is what gets committed. Note that a partially staged file will have
# its unstaged hunks pulled into the commit by the re-add.
AIR="${AIR:-air}"
if ! command -v "$AIR" >/dev/null 2>&1; then
  echo "==> [pre-commit] air not found on PATH (set AIR=/path/to/air to override)." >&2
  echo "    Install it from https://posit-dev.github.io/air/cli.html" >&2
  exit 1
fi

mapfile -t staged_r < <(git diff --cached --name-only --diff-filter=ACMR -- '*.R' '*.r')
if ((${#staged_r[@]})); then
  echo "==> [pre-commit] Formatting staged R files with air"
  "$AIR" format "${staged_r[@]}"
  git add -- "${staged_r[@]}"
fi

echo "==> [pre-commit] Building roxygen2 documentation"
Rscript -e 'devtools::document()'
git add DESCRIPTION NAMESPACE man

echo "==> [pre-commit] Running tests"
Rscript -e 'devtools::test(stop_on_failure = TRUE)'
